# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Application URL (optional, defaults to window.location.origin)
# Used for authentication redirect URLs and public bio links
VITE_APP_URL="https://heylink-studio.vercel.app"

# GEMINI_API_KEY: Optional if AI bio/link generation features are enabled
GEMINI_API_KEY="MY_GEMINI_API_KEY"

